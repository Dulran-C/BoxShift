<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="BoxShift.Pages.EditorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Level Editor"
    BackgroundColor="{AppThemeBinding Light=#F5F7FB, Dark=#12131A}">

    <ScrollView>

        <VerticalStackLayout
            Padding="18"
            Spacing="16">

            <VerticalStackLayout
                Spacing="4">

                <Label
                    Text="Level Editor"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light=#171821, Dark=White}" />

                <Label
                    Text="Build, test and save your own Sokoban level."
                    FontSize="14"
                    TextColor="{AppThemeBinding Light=#6B6F7A, Dark=#A6A9B5}" />

            </VerticalStackLayout>

            <Border
                Padding="18"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light=#E1E4EA, Dark=#343744}"
                Background="{AppThemeBinding Light=White, Dark=#1E202A}"
                StrokeShape="RoundRectangle 16">

                <VerticalStackLayout
                    Spacing="14">

                    <Label
                        Text="Level Details"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light=#171821, Dark=White}" />

                    <Entry
                        x:Name="LevelNameEntry"
                        Placeholder="Custom level name"
                        Text="My Level" />

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="15">

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="5">

                            <Label
                                Text="Rows"
                                HorizontalOptions="Center"
                                FontAttributes="Bold" />

                            <Picker
                                x:Name="RowsPicker"
                                HorizontalOptions="Fill" />

                        </VerticalStackLayout>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="5">

                            <Label
                                Text="Columns"
                                HorizontalOptions="Center"
                                FontAttributes="Bold" />

                            <Picker
                                x:Name="ColumnsPicker"
                                HorizontalOptions="Fill" />

                        </VerticalStackLayout>

                    </Grid>

                    <Button
                        Text="Create Grid"
                        HeightRequest="46"
                        CornerRadius="12"
                        BackgroundColor="#5746E8"
                        TextColor="White"
                        FontAttributes="Bold"
                        Clicked="CreateGridClicked" />

                </VerticalStackLayout>

            </Border>

            <Border
                Padding="18"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light=#E1E4EA, Dark=#343744}"
                Background="{AppThemeBinding Light=White, Dark=#1E202A}"
                StrokeShape="RoundRectangle 16">

                <VerticalStackLayout
                    Spacing="12">

                    <Label
                        Text="Choose a Tile"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light=#171821, Dark=White}" />

                    <Grid
                        x:Name="EditorTools"
                        ColumnDefinitions="*,*,*,*,*"
                        ColumnSpacing="5">

                        <Button
                            x:Name="WallToolButton"
                            Grid.Column="0"
                            Text="Wall"
                            FontSize="12"
                            Padding="4"
                            CommandParameter="Wall"
                            Clicked="ToolClicked" />

                        <Button
                            x:Name="FloorToolButton"
                            Grid.Column="1"
                            Text="Floor"
                            FontSize="12"
                            Padding="4"
                            CommandParameter="Floor"
                            Clicked="ToolClicked" />

                        <Button
                            x:Name="BoxToolButton"
                            Grid.Column="2"
                            Text="Box"
                            FontSize="12"
                            Padding="4"
                            CommandParameter="Box"
                            Clicked="ToolClicked" />

                        <Button
                            x:Name="TargetToolButton"
                            Grid.Column="3"
                            Text="Target"
                            FontSize="12"
                            Padding="4"
                            CommandParameter="Target"
                            Clicked="ToolClicked" />

                        <Button
                            x:Name="PlayerToolButton"
                            Grid.Column="4"
                            Text="Player"
                            FontSize="12"
                            Padding="4"
                            CommandParameter="Player"
                            Clicked="ToolClicked" />

                    </Grid>

                    <Label
                        x:Name="SelectedToolLabel"
                        Text="Selected: Wall"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        TextColor="#6558E8" />

                </VerticalStackLayout>

            </Border>

            <Border
                Padding="15"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light=#E1E4EA, Dark=#343744}"
                Background="{AppThemeBinding Light=White, Dark=#1E202A}"
                StrokeShape="RoundRectangle 16">

                <ScrollView
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never">

                    <Grid
                        x:Name="EditorGrid"
                        RowSpacing="2"
                        ColumnSpacing="2"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />

                </ScrollView>

            </Border>

            <Label
                x:Name="EditorStatus"
                Text=""
                FontAttributes="Bold"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                TextColor="{AppThemeBinding Light=#555965, Dark=#D2D4DC}" />

            <Button
                x:Name="TestButton"
                Text="Test Level"
                HeightRequest="48"
                CornerRadius="12"
                BackgroundColor="#5746E8"
                TextColor="White"
                FontAttributes="Bold"
                Clicked="TestLevelClicked" />

            <Grid
                x:Name="TestControls"
                IsVisible="False"
                RowDefinitions="Auto,Auto"
                ColumnDefinitions="Auto,Auto,Auto"
                HorizontalOptions="Center"
                ColumnSpacing="8"
                RowSpacing="8">

                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="↑"
                    FontSize="20"
                    WidthRequest="58"
                    HeightRequest="46"
                    CornerRadius="12"
                    BackgroundColor="#5746E8"
                    TextColor="White"
                    Clicked="TestUpClicked" />

                <Button
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="←"
                    FontSize="20"
                    WidthRequest="58"
                    HeightRequest="46"
                    CornerRadius="12"
                    BackgroundColor="#5746E8"
                    TextColor="White"
                    Clicked="TestLeftClicked" />

                <Button
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="↓"
                    FontSize="20"
                    WidthRequest="58"
                    HeightRequest="46"
                    CornerRadius="12"
                    BackgroundColor="#5746E8"
                    TextColor="White"
                    Clicked="TestDownClicked" />

                <Button
                    Grid.Row="1"
                    Grid.Column="2"
                    Text="→"
                    FontSize="20"
                    WidthRequest="58"
                    HeightRequest="46"
                    CornerRadius="12"
                    BackgroundColor="#5746E8"
                    TextColor="White"
                    Clicked="TestRightClicked" />

            </Grid>

            <Button
                x:Name="CancelTestButton"
                Text="Stop Test"
                IsVisible="False"
                HeightRequest="46"
                CornerRadius="12"
                Clicked="CancelTestClicked" />

            <Button
                x:Name="SaveButton"
                Text="Save Level"
                IsEnabled="False"
                HeightRequest="48"
                CornerRadius="12"
                BackgroundColor="#2F855A"
                TextColor="White"
                FontAttributes="Bold"
                Clicked="SaveLevelClicked" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>