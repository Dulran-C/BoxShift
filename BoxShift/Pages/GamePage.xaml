<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="BoxShift.Pages.GamePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="BoxShift">

    <Grid
        Padding="20"
        RowDefinitions="Auto,*,Auto,Auto,Auto">

        <Label
            x:Name="LevelTitle"
            Grid.Row="0"
            Text="Level"
            FontSize="28"
            FontAttributes="Bold"
            HorizontalOptions="Center"
            Margin="0,10,0,20" />

        <Grid
            x:Name="BoardGrid"
            Grid.Row="1"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

        <Label
            x:Name="MoveCounter"
            Grid.Row="2"
            Text="Moves: 0"
            FontSize="20"
            HorizontalOptions="Center"
            Margin="0,20,0,10" />

        <Grid
            Grid.Row="3"
            RowDefinitions="Auto,Auto"
            ColumnDefinitions="Auto,Auto,Auto"
            HorizontalOptions="Center"
            ColumnSpacing="10"
            RowSpacing="10"
            Margin="0,10,0,10">

            <Button
                Grid.Row="0"
                Grid.Column="1"
                Text="↑"
                FontSize="24"
                WidthRequest="60"
                HeightRequest="50"
                Clicked="UpClicked" />

            <Button
                Grid.Row="1"
                Grid.Column="0"
                Text="←"
                FontSize="24"
                WidthRequest="60"
                HeightRequest="50"
                Clicked="LeftClicked" />

            <Button
                Grid.Row="1"
                Grid.Column="1"
                Text="↓"
                FontSize="24"
                WidthRequest="60"
                HeightRequest="50"
                Clicked="DownClicked" />

            <Button
                Grid.Row="1"
                Grid.Column="2"
                Text="→"
                FontSize="24"
                WidthRequest="60"
                HeightRequest="50"
                Clicked="RightClicked" />

        </Grid>

        <HorizontalStackLayout
            Grid.Row="4"
            HorizontalOptions="Center"
            Spacing="15"
            Margin="0,10,0,10">

            <Button
                Text="Undo"
                WidthRequest="100"
                Clicked="UndoClicked" />

            <Button
                Text="Reset"
                WidthRequest="100"
                Clicked="ResetClicked" />

        </HorizontalStackLayout>

    </Grid>

</ContentPage>