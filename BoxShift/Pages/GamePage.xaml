<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="BoxShift.Pages.GamePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="BoxShift">

    <Grid
        Padding="15"
        RowDefinitions="Auto,*,Auto,Auto,Auto">

        <Label
            x:Name="LevelTitle"
            Grid.Row="0"
            Text="Level"
            FontSize="26"
            FontAttributes="Bold"
            HorizontalOptions="Center"
            Margin="0,5,0,10" />

        <ScrollView
            Grid.Row="1"
            Orientation="Both"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">

            <Grid 
                x:Name="BoardGrid"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

        </ScrollView>

        <Label
            x:Name="MoveCounter"
            Grid.Row="2"
            Text="Moves: 0"
            FontSize="18"
            HorizontalOptions="Center"
            Margin="0,10,0,5" />

        <Grid
            Grid.Row="3"
            RowDefinitions="Auto,Auto"
            ColumnDefinitions="Auto,Auto,Auto"
            HorizontalOptions="Center"
            ColumnSpacing="8"
            RowSpacing="8"
            Margin="0,5">

            <Button
                Grid.Row="0"
                Grid.Column="1"
                Text="↑"
                FontSize="20"
                WidthRequest="55"
                HeightRequest="45"
                Clicked="UpClicked" />

            <Button
                Grid.Row="1"
                Grid.Column="0"
                Text="←"
                FontSize="20"
                WidthRequest="55"
                HeightRequest="45"
                Clicked="LeftClicked" />

            <Button
                Grid.Row="1"
                Grid.Column="1"
                Text="↓"
                FontSize="20"
                WidthRequest="55"
                HeightRequest="45"
                Clicked="DownClicked" />

            <Button
                Grid.Row="1"
                Grid.Column="2"
                Text="→"
                FontSize="20"
                WidthRequest="55"
                HeightRequest="45"
                Clicked="RightClicked" />

        </Grid>

        <HorizontalStackLayout
            Grid.Row="4"
            HorizontalOptions="Center"
            Spacing="12"
            Margin="0,5,0,5">

            <Button
                Text="Undo"
                WidthRequest="90"
                HeightRequest="42"
                Clicked="UndoClicked" />

            <Button
                Text="Reset"
                WidthRequest="90"
                HeightRequest="42"
                Clicked="ResetClicked" />

        </HorizontalStackLayout>

    </Grid>

</ContentPage>