<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="BoxShift.Pages.LevelSelectPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Levels">

    <Grid
        Padding="25"
        RowDefinitions="Auto,Auto,*">

        <VerticalStackLayout
            Grid.Row="0"
            Spacing="5"
            Margin="0,10,0,15">

            <Label
                Text="Choose a Level"
                FontSize="32"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Select a puzzle to begin"
                FontSize="16"
                HorizontalOptions="Center" />

        </VerticalStackLayout>

        <Button
            Grid.Row="1"
            Text="Create Custom Level"
            Clicked="EditorClicked"
            HorizontalOptions="Center"
            WidthRequest="220"
            Margin="0,0,0,15" />

        <CollectionView
            x:Name="LevelsCollection"
            Grid.Row="2"
            SelectionMode="None">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Margin="0,6"
                        Padding="15"
                        StrokeThickness="1">

                        <Grid
                            ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,Auto">

                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="{Binding Name}"
                                FontSize="20"
                                FontAttributes="Bold" />

                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="{Binding ProgressText}"
                                FontSize="14" />

                            <Button
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="1"
                                Text="Play"
                                WidthRequest="90"
                                CommandParameter="{Binding LevelIndex}"
                                Clicked="PlayLevelClicked"
                                VerticalOptions="Center" />

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>