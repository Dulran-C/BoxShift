<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="BoxShift.Pages.LevelSelectPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Levels"
    BackgroundColor="{AppThemeBinding Light=#F5F7FB, Dark=#12131A}">

    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="16">

        <VerticalStackLayout
            Grid.Row="0"
            Spacing="4">

            <Label
                Text="Choose a Level"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light=#171821, Dark=White}" />

            <Label
                Text="Complete levels and improve your best move score."
                FontSize="14"
                TextColor="{AppThemeBinding Light=#6B6F7A, Dark=#A6A9B5}" />

        </VerticalStackLayout>

        <Button
            Grid.Row="1"
            Text="Create Custom Level"
            HeightRequest="50"
            CornerRadius="14"
            FontSize="16"
            FontAttributes="Bold"
            BackgroundColor="#5746E8"
            TextColor="White"
            Clicked="EditorClicked" />

        <CollectionView
            x:Name="LevelsCollection"
            Grid.Row="2"
            SelectionMode="None">

            <CollectionView.EmptyView>

                <VerticalStackLayout
                    Padding="30"
                    Spacing="8"
                    HorizontalOptions="Center">

                    <Label
                        Text="No levels available"
                        FontSize="18"
                        FontAttributes="Bold"
                        HorizontalOptions="Center" />

                    <Label
                        Text="Check your level file or create a custom level."
                        FontSize="14"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Margin="0,0,0,12"
                        Padding="18"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#E1E4EA, Dark=#343744}"
                        Background="{AppThemeBinding Light=White, Dark=#1E202A}"
                        StrokeShape="RoundRectangle 16">

                        <Grid
                            RowDefinitions="Auto,Auto"
                            ColumnDefinitions="*,Auto"
                            RowSpacing="12">

                            <VerticalStackLayout
                                Grid.Row="0"
                                Grid.Column="0"
                                Spacing="4">

                                <Label
                                    Text="{Binding Name}"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    TextColor="{AppThemeBinding Light=#171821, Dark=White}" />

                                <Label
                                    Text="{Binding ProgressText}"
                                    FontSize="13"
                                    TextColor="{AppThemeBinding Light=#70747F, Dark=#A8ABB6}" />

                            </VerticalStackLayout>

                            <Button
                                Grid.Row="0"
                                Grid.Column="1"
                                Text="Play"
                                WidthRequest="85"
                                HeightRequest="42"
                                CornerRadius="12"
                                BackgroundColor="#5746E8"
                                TextColor="White"
                                FontAttributes="Bold"
                                CommandParameter="{Binding .}"
                                Clicked="PlayLevelClicked" />

                            <HorizontalStackLayout
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Spacing="10"
                                IsVisible="{Binding IsCustom}">

                                <Button
                                    Text="Edit"
                                    WidthRequest="90"
                                    HeightRequest="40"
                                    CornerRadius="10"
                                    CommandParameter="{Binding LevelIndex}"
                                    Clicked="EditLevelClicked" />

                                <Button
                                    Text="Delete"
                                    WidthRequest="90"
                                    HeightRequest="40"
                                    CornerRadius="10"
                                    BackgroundColor="#C94B4B"
                                    TextColor="White"
                                    CommandParameter="{Binding LevelIndex}"
                                    Clicked="DeleteLevelClicked" />

                            </HorizontalStackLayout>

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>